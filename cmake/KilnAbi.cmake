# Derives the import table of the plugin ABI from the normative headers (every header of wire-wasm/abi, areas
# included), so the checker never drifts from them. The parser is Wire's basalt_wasm_abi_rows().
function(kiln_generate_abi ABI_DIR OUTPUT)
    basalt_wasm_abi_headers(${ABI_DIR} headers)
    basalt_wasm_abi_rows(rows ${headers})
    set(serverRows "")
    set(proxyRows "")
    set(serverCount 0)
    set(proxyCount 0)
    foreach(row ${rows})
        string(REPLACE "|" ";" f "${row}")
        list(GET f 0 module)
        list(GET f 1 name)
        list(GET f 2 params)
        list(GET f 3 result)
        list(GET f 4 scope)
        if(scope STREQUAL "shared")
            set(shared true)
        else()
            set(shared false)
        endif()
        set(line "    {\"${name}\", \"${params}\", '${result}', ${shared}},\n")
        if(module STREQUAL "basalt")
            string(APPEND serverRows "${line}")
            math(EXPR serverCount "${serverCount} + 1")
        else()
            string(APPEND proxyRows "${line}")
            math(EXPR proxyCount "${proxyCount} + 1")
        endif()
    endforeach()
    if(serverCount LESS 10 OR proxyCount LESS 5)
        message(FATAL_ERROR "the ABI headers yielded ${serverCount} and ${proxyCount} imports, the parser is out of step")
    endif()
    basalt_wasm_abi_version(version ${ABI_DIR}/basalt_abi.h)
    file(WRITE ${OUTPUT}.tmp "#include \"AbiTable.hpp\"\n\nnamespace basalt::kiln::abi {\n\n"
        "const std::vector<ImportSpec> kImports{\n${serverRows}};\n\n"
        "const std::vector<ImportSpec> kProxyImports{\n${proxyRows}};\n\nconst int kVersion = ${version};\n\n}\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
endfunction()
