include(GNUInstallDirs)

set(KILN_RELEASE_PLATFORM "" CACHE STRING "Release asset platform, such as Linux-x64")
if(NOT KILN_RELEASE_PLATFORM)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
        set(_kiln_arch arm64)
    else()
        set(_kiln_arch x64)
    endif()
    if(APPLE)
        if(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
            set(_kiln_arch x64)
        endif()
        set(KILN_RELEASE_PLATFORM "macOS-${_kiln_arch}")
    elseif(WIN32)
        set(KILN_RELEASE_PLATFORM "Windows-${_kiln_arch}")
    else()
        set(KILN_RELEASE_PLATFORM "${CMAKE_SYSTEM_NAME}-${_kiln_arch}")
    endif()
endif()

if(WIN32)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    include(InstallRequiredSystemLibraries)
    if(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
        install(PROGRAMS ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS} DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
    endif()
endif()

install(TARGETS kiln RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
install(FILES packaging/kiln.installation DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
install(FILES LICENSE DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/basalt-kiln COMPONENT Runtime)

set(CPACK_VERBATIM_VARIABLES ON)
set(CPACK_PACKAGE_NAME basalt-kiln)
set(CPACK_PACKAGE_VENDOR "Basalt Project")
set(CPACK_PACKAGE_CONTACT "Whiron <dnlblasco@gmail.com>")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://basaltmc.org")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Build, check and pack Basalt WebAssembly plugins")
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" CPACK_PACKAGE_VERSION "${BASALT_VERSION}")
if(NOT CPACK_PACKAGE_VERSION)
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
endif()
set(CPACK_PACKAGE_FILE_NAME "Kiln-Installer-${BASALT_VERSION}-${KILN_RELEASE_PLATFORM}")
configure_file(LICENSE ${CMAKE_CURRENT_BINARY_DIR}/LICENSE.txt COPYONLY)
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_BINARY_DIR}/LICENSE.txt")
set(CPACK_COMPONENTS_ALL Runtime)
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${PROJECT_NAME};Runtime;/")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEBIAN_PACKAGE_NAME basalt-kiln)
set(CPACK_DEBIAN_PACKAGE_SECTION devel)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "ca-certificates")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.deb")
set(CPACK_RPM_PACKAGE_NAME basalt-kiln)
set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-only")
set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.rpm")
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
set(CPACK_RPM_PACKAGE_REQUIRES "ca-certificates")
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION "/usr/share/licenses")
set(CPACK_FREEBSD_PACKAGE_NAME basalt-kiln)
set(CPACK_FREEBSD_PACKAGE_ORIGIN devel/basalt-kiln)
set(CPACK_FREEBSD_PACKAGE_MAINTAINER "Basalt Project")
set(CPACK_FREEBSD_PACKAGE_LICENSE GPLv3)
set(CPACK_FREEBSD_PACKAGE_CATEGORIES devel)
set(CPACK_FREEBSD_PACKAGE_WWW "https://basaltmc.org")

if(WIN32)
    if(CMAKE_VERSION VERSION_LESS "4.3")
        message(FATAL_ERROR "The per-user MSI installer requires CMake 4.3 or newer")
    endif()
    set(CPACK_GENERATOR WIX)
    set(CPACK_PACKAGE_INSTALL_DIRECTORY "Basalt\\Kiln")
    set(CPACK_WIX_VERSION 4)
    set(CPACK_WIX_INSTALL_SCOPE perUser)
    set(CPACK_WIX_UPGRADE_GUID "8C403E25-7457-49C5-BC3F-49BCFA3DC246")
    set(CPACK_WIX_COMPONENT_KEYS_REGISTRY_PATH "Software\\Basalt\\Kiln\\Components")
    set(CPACK_WIX_PATCH_FILE "${CMAKE_CURRENT_SOURCE_DIR}/packaging/windows-path.xml")
    set(CPACK_WIX_PROPERTY_ARPURLINFOABOUT "https://basaltmc.org")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/")
elseif(APPLE)
    set(CPACK_COMPONENT_RUNTIME_REQUIRED TRUE)
    set(CPACK_MONOLITHIC_INSTALL OFF)
    set(CPACK_INSTALL_CMAKE_PROJECTS "${CMAKE_BINARY_DIR};${PROJECT_NAME};ALL;/")
    set(CPACK_GENERATOR productbuild)
    set(CPACK_PACKAGING_INSTALL_PREFIX "/usr/local")
    set(CPACK_PRODUCTBUILD_IDENTIFIER "org.basaltmc.kiln")
    set(CPACK_PRODUCTBUILD_DOMAINS ON)
    set(CPACK_PRODUCTBUILD_DOMAINS_ANYWHERE OFF)
    set(CPACK_PRODUCTBUILD_DOMAINS_ROOT ON)
    set(CPACK_PRODUCTBUILD_DOMAINS_USER OFF)
elseif(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
    set(CPACK_GENERATOR FREEBSD)
    set(CPACK_PACKAGING_INSTALL_PREFIX "/usr/local")
else()
    set(CPACK_GENERATOR "DEB;RPM")
endif()

configure_file(packaging/install.sh.in ${CMAKE_CURRENT_BINARY_DIR}/install.sh @ONLY)
include(CPack)
