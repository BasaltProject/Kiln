using Basalt.Shared.Core;
using Basalt.Shared.Internal;
using Basalt.Shared.Values;
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using static Basalt.Shared.Core.Level;
using static Basalt.Shared.Core.Priority;
using static Basalt.Shared.Internal.Native;

namespace Basalt.Shared.Commands;

public static unsafe class Registry {
    public static int Register(string spec, string permission, Handler handler)
    {
        byte[] s = Utf8(spec);
        byte[] perm = Utf8(permission);
        int token = TokenFor(handler);
        fixed (byte* sp = s)
        fixed (byte* pp = perm)
            return RawCommandRegister(sp, s.Length, pp, perm.Length, token);
    }
}
