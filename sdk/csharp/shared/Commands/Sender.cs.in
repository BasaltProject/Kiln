using Basalt.Shared.Core;
using Basalt.Shared.Internal;
using Basalt.Shared.Values;
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using static Basalt.Shared.Core.Level;
using static Basalt.Shared.Core.Priority;
using static Basalt.Shared.Internal.Native;

namespace Basalt.Shared.Commands;

public static unsafe class Sender {
    public static int Reply(int ctx, string text, Args args = null)
    {
        byte[] t = Utf8(text);
        byte[] a = args?.Packed();
        fixed (byte* tp = t)
        fixed (byte* ap = a)
            return RawCommandReply(ctx, tp, t.Length, ap, a == null ? 0 : a.Length);
    }

    public static string Name(int ctx) => Fetch((o, c) => RawCommandSourceName(ctx, o, c));

    public static bool IsConsole(int ctx) => RawCommandIsConsole(ctx) != 0;
}
