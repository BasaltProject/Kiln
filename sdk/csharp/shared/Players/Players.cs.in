using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using Basalt.Shared.Core;
using Basalt.Shared.Internal;
using Basalt.Shared.Values;
using static Basalt.Shared.Internal.Native;
using static Basalt.Shared.Core.Level;
using static Basalt.Shared.Core.Priority;
namespace Basalt.Shared.Players;

public static unsafe partial class Players {
    public static int PlayerByName(string name)
    {
        byte[] n = Utf8(name);
        fixed (byte* p = n) return RawPlayerByName(p, n.Length);
    }

    public static int[] PlayersOnline()
    {
        int cap = 64;
        while (true)
        {
            int[] buffer = new int[cap];
            int n;
            fixed (int* p = buffer) n = RawPlayersOnline(p, cap);
            if (n < 0)
            {
                return new int[0];
            }
            if (n > cap)
            {
                cap = n;
                continue;
            }
            int[] result = new int[n];
            Array.Copy(buffer, result, n);
            return result;
        }
    }

    public static string PlayerName(int player) => Fetch((o, c) => RawPlayerName(player, o, c));

    public static int Send(int player, string text, Args args = null)
    {
        byte[] t = Utf8(text);
        byte[] a = args?.Packed();
        fixed (byte* tp = t)
        fixed (byte* ap = a)
            return RawPlayerSend(player, tp, t.Length, ap, a == null ? 0 : a.Length);
    }

    public static int ActionBar(int player, string text, Args args = null)
    {
        byte[] t = Utf8(text);
        byte[] a = args?.Packed();
        fixed (byte* tp = t)
        fixed (byte* ap = a)
            return RawPlayerActionBar(player, tp, t.Length, ap, a == null ? 0 : a.Length);
    }
}
