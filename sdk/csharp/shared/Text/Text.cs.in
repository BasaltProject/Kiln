using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;
using Basalt.Shared.Core;
using Basalt.Shared.Internal;
using Basalt.Shared.Values;
using static Basalt.Shared.Internal.Native;
using static Basalt.Shared.Core.Level;
using static Basalt.Shared.Core.Priority;
namespace Basalt.Shared.Text;

public static unsafe partial class Text {
    public static string Translate(string key, Args args = null)
    {
        byte[] k = Utf8(key);
        byte[] a = args?.Packed();
        return Fetch((o, c) =>
        {
            fixed (byte* kp = k)
            fixed (byte* ap = a)
                return RawTranslate(kp, k.Length, ap, a == null ? 0 : a.Length, o, c);
        });
    }
}
