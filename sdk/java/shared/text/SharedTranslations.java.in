package org.basaltmc.shared.text;

import org.basaltmc.shared.core.*;

import static org.basaltmc.shared.core.Level.*;
import static org.basaltmc.shared.core.Priority.*;
import static org.basaltmc.shared.internal.Callbacks.*;
import static org.basaltmc.shared.internal.Native.*;
import static org.basaltmc.shared.internal.RawCore.*;

abstract class SharedTranslations {
    public static String translate(String key) { return translate(key, null); }

    public static String translate(String key, Args args) {
        byte[] k = utf8(key);
        byte[] a = packed(args);
        return fetch((out, cap) -> rawTranslate(at(k), k.length, at(a), a.length, out, cap));
    }
}
