package org.basaltmc.shared.commands;

import org.basaltmc.shared.core.*;
import org.teavm.interop.Address;

import static org.basaltmc.shared.core.Level.*;
import static org.basaltmc.shared.core.Priority.*;
import static org.basaltmc.shared.internal.Callbacks.*;
import static org.basaltmc.shared.internal.Native.*;
import static org.basaltmc.shared.internal.RawCore.*;

public final class Arguments {
    private Arguments() {}

    public static String str(int ctx, String name) {
        byte[] n = utf8(name);
        return fetch((out, cap) -> rawCommandArgStr(ctx, at(n), n.length, out, cap));
    }

    public static Long i64(int ctx, String name) {
        byte[] n = utf8(name);
        long[] out = new long[1];
        return rawCommandArgI64(ctx, at(n), n.length, Address.ofData(out)) == 0 ? Long.valueOf(out[0]) : null;
    }
}
